APP_NAME="Personal Blog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Host of this URL is the platform host; other hosts are treated as custom blog domains.
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Temporary local bypass only. Keep true in production.
IDENTITY_EMAIL_VERIFICATION_ENABLED=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0.16+ only (the schema uses CHECK constraints). Matches docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blog
DB_USERNAME=root
DB_PASSWORD=

# Must stay "database": locking or resetting a password deletes the user's rows in `sessions`.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use MAIL_MAILER=log during development to write emails to storage/logs instead of sending them.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=<gmail address>,
# MAIL_PASSWORD=<app password from Google Account > Security > App passwords>.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# cloudinary://<api_key>:<api_secret>@<cloud_name>  (server-side only, never expose to the frontend)
MEDIA_DRIVER=local
MEDIA_LOCAL_DISK=public
CLOUDINARY_URL=
CLOUDINARY_FOLDER_PREFIX=personal-blog
MEDIA_MAX_UPLOAD_KB=5120

VITE_APP_NAME="${APP_NAME}"

# Super admin sign-in credentials for initial setup. Change these after first login.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123456789
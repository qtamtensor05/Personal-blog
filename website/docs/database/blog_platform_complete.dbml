Project blog_platform {
  database_type: 'MySQL'
  Note: 'Multi-Tenant Blog Platform | Laravel + MySQL + Cloudinary + GrapesJS + Tiptap. Composite FK bảo vệ tenant. SQL bổ sung CHECK; README mô tả quy tắc nghiệp vụ.'
}

Enum account_status {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DISABLED
}

Enum blog_status {
  DRAFT
  PUBLISHED
  HIDDEN
  SUSPENDED
  ARCHIVED
}

Enum blog_visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

Enum template_status {
  DRAFT
  PUBLISHED
  HIDDEN
  RETIRED
}

Enum content_status {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

Enum media_status {
  UPLOADING
  READY
  FAILED
  DELETING
  DELETED
}

Enum media_scope {
  PLATFORM
  BLOG
  USER
}

Enum restriction_kind {
  LOCK
  SUSPEND
  DISABLE
}

Enum restriction_status {
  ACTIVE
  REVOKED
  EXPIRED
}

Enum report_status {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

Enum report_target {
  BLOG
  POST
}

Enum domain_status {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
  DISABLED
}

Table users {
  Note: 'Tài khoản chung. User là mặc định; quyền quản trị cấp qua user_platform_roles; quyền Owner suy ra từ blogs.owner_user_id.'
  id "bigint unsigned" [pk, increment, not null]
  name varchar(160) [not null]
  email varchar(254) [not null]
  email_verified_at datetime [null]
  password varchar(255) [not null, note: 'Mật khẩu đã hash, không lưu bản rõ.']
  status account_status [not null, default: 'PENDING_VERIFICATION']
  locked_until datetime [null]
  last_login_at datetime [null]
  remember_token varchar(100) [null]
  avatar_media_id "bigint unsigned" [null]
  two_factor_secret text [null, note: 'Mã hóa bằng khóa ứng dụng.']
  two_factor_recovery_codes text [null, note: 'Mã hóa; không hiển thị trong log.']
  two_factor_confirmed_at datetime [null]
  deleted_at datetime [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (email) [unique]
  }
}

Table platform_roles {
  Note: 'SUPER_ADMIN và PLATFORM_ADMIN. Chủ blog xác định bằng blogs.owner_user_id.'
  id "bigint unsigned" [pk, increment, not null]
  code varchar(60) [not null]
  name varchar(160) [not null]
  description text [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (code) [unique]
  }
}

Table permissions {
  Note: 'Quyền platform.* cho quản trị nền tảng. Owner dùng Policy kiểm tra blogs.owner_user_id; không có RBAC thành viên blog.'
  id "bigint unsigned" [pk, increment, not null]
  code varchar(120) [not null]
  scope varchar(20) [not null]
  description text [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (code) [unique]
  }
}

Table platform_role_permissions {
  Note: 'Quyền của vai trò nền tảng.'
  id "bigint unsigned" [pk, increment, not null]
  role_id "bigint unsigned" [not null]
  permission_id "bigint unsigned" [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (role_id, permission_id) [unique]
  }
}

Table user_platform_roles {
  Note: 'Gán quyền quản trị nền tảng. User thường không cần bản ghi tại đây.'
  id "bigint unsigned" [pk, increment, not null]
  user_id "bigint unsigned" [not null]
  role_id "bigint unsigned" [not null]
  granted_by "bigint unsigned" [not null]
  expires_at datetime [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (user_id, role_id) [unique]
  }
}

Table sessions {
  Note: 'Database session driver Laravel. Thu hồi bằng xóa session; last_activity là Unix timestamp.'
  id varchar(255) [pk, not null]
  user_id "bigint unsigned" [null]
  ip_address varchar(45) [null]
  user_agent text [null]
  payload longtext [not null]
  last_activity "int unsigned" [not null]
  indexes {
    (user_id)
    (last_activity)
  }
}

Table password_reset_tokens {
  Note: 'Theo cấu trúc password broker Laravel. Token được hash và có TTL ở cấu hình.'
  email varchar(254) [pk, not null]
  token varchar(255) [not null]
  created_at datetime [null]
  indexes {
  }
}

Table account_restrictions {
  Note: 'Lịch sử khóa/đình chỉ/vô hiệu hóa; đồng bộ users.status trong transaction. Mở khóa không mặc định ACTIVE nếu email chưa xác thực.'
  id "bigint unsigned" [pk, increment, not null]
  user_id "bigint unsigned" [not null]
  kind restriction_kind [not null]
  status restriction_status [not null, default: 'ACTIVE']
  reason text [not null]
  issued_by "bigint unsigned" [not null]
  starts_at datetime [not null]
  ends_at datetime [null]
  revoked_by "bigint unsigned" [null]
  revoked_at datetime [null]
  revoke_reason text [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (user_id, status, ends_at)
  }
}

Table security_audit_logs {
  Note: 'Append-only. Không lưu password, OTP, token, recovery code. actor/subject nullable cho thất bại đăng nhập.'
  id "bigint unsigned" [pk, increment, not null]
  actor_user_id "bigint unsigned" [null]
  subject_user_id "bigint unsigned" [null]
  event varchar(120) [not null]
  outcome varchar(20) [not null]
  ip_address varchar(45) [null]
  user_agent text [null]
  context json [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (subject_user_id, created_at)
    (event, created_at)
  }
}

Table blog_topics {
  Note: 'Chủ đề blog trên Main Website; khác danh mục bài viết trong từng blog.'
  id "bigint unsigned" [pk, increment, not null]
  name varchar(160) [not null]
  slug varchar(160) [not null]
  is_active boolean [not null, default: true]
  created_by "bigint unsigned" [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (slug) [unique]
  }
}

Table blogs {
  Note: 'Tenant gốc, một chủ sở hữu qua owner_user_id. Không có thành viên, lời mời hoặc vai trò Editor. Trạng thái và visibility độc lập.'
  id "bigint unsigned" [pk, increment, not null]
  owner_user_id "bigint unsigned" [not null]
  name varchar(160) [not null]
  slug varchar(160) [not null]
  description text [null]
  status blog_status [not null, default: 'DRAFT']
  visibility blog_visibility [not null, default: 'PUBLIC']
  discoverable boolean [not null, default: true]
  published_at datetime [null]
  deleted_at datetime [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (slug) [unique]
    (owner_user_id, status)
    (status, visibility, discoverable)
  }
}

Table blog_topic_assignments {
  Note: 'Phân loại blog trong thư viện khám phá.'
  id "bigint unsigned" [pk, increment, not null]
  blog_id "bigint unsigned" [not null]
  topic_id "bigint unsigned" [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (blog_id, topic_id) [unique]
  }
}

Table blog_settings {
  Note: '1:1 cài đặt riêng mỗi blog; JSON cho liên kết xã hội và giới hạn do nền tảng cấp.'
  blog_id "bigint unsigned" [pk, not null]
  locale varchar(20) [not null, default: 'vi']
  timezone varchar(80) [not null, default: 'Asia/Ho_Chi_Minh']
  logo_media_id "bigint unsigned" [null]
  favicon_media_id "bigint unsigned" [null]
  posts_per_page "int unsigned" [not null, default: 10]
  social_links json [null]
  seo_title varchar(255) [null]
  seo_description varchar(500) [null]
  og_media_id "bigint unsigned" [null]
  storage_quota_bytes "bigint unsigned" [not null, default: 104857600]
  post_limit "int unsigned" [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
  }
}

Table blog_domains {
  Note: 'Mở rộng: tên miền tùy chỉnh; chỉ phục vụ khi xác minh chủ sở hữu DNS và HTTPS thành công.'
  id "bigint unsigned" [pk, increment, not null]
  blog_id "bigint unsigned" [not null]
  hostname varchar(253) [not null]
  status domain_status [not null, default: 'PENDING']
  verification_token_hash char(64) [not null]
  verified_at datetime [null]
  activated_at datetime [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (hostname) [unique]
    (blog_id, id) [unique]
  }
}

Table template_categories {
  Note: 'Loại mẫu/ngành/chủ đề trong thư viện template như ảnh tham khảo.'
  id "bigint unsigned" [pk, increment, not null]
  name varchar(160) [not null]
  slug varchar(160) [not null]
  kind varchar(20) [not null]
  parent_id "bigint unsigned" [null]
  is_active boolean [not null, default: true]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (kind, slug) [unique]
  }
}

Table templates {
  Note: 'Một hàng cho mỗi mẫu. Cấu trúc trang/section/theme/menu/rules gộp vào template_data JSON; draft_data giữ một bản nháp. Không có các bảng chi tiết hoặc lịch sử template.'
  id "bigint unsigned" [pk, increment, not null]
  name varchar(160) [not null]
  slug varchar(160) [not null]
  description text [null]
  status template_status [not null, default: 'DRAFT']
  preview_media_id "bigint unsigned" [null]
  demo_url varchar(2048) [null]
  created_by "bigint unsigned" [not null]
  updated_by "bigint unsigned" [not null]
  deleted_at datetime [null]
  version_number "int unsigned" [not null, default: 0, note: 'Tăng khi publish; không có bảng lịch sử phiên bản.']
  template_data json [null, note: 'Mẫu đã công bố: GrapesJS project, theme defaults/schema, section rules, page definitions, menu defaults và bindings.']
  draft_data json [null, note: 'Một bản chỉnh sửa template chờ công bố.']
  published_by "bigint unsigned" [null]
  published_at datetime [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (slug) [unique]
    (status, created_at)
  }
}

Table template_category_assignments {
  Note: 'N:M phân loại template.'
  id "bigint unsigned" [pk, increment, not null]
  template_id "bigint unsigned" [not null]
  category_id "bigint unsigned" [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (template_id, category_id) [unique]
  }
}

Table pages {
  Note: 'Nội dung và SEO trang tĩnh cùng một hàng; content_json là Tiptap JSON. Layout và menu nằm trong blog_designs. page_key ổn định để binding.'
  id "bigint unsigned" [pk, increment, not null]
  blog_id "bigint unsigned" [not null]
  title varchar(160) [not null]
  slug varchar(160) [not null]
  page_key varchar(80) [not null]
  content_json json [not null]
  seo_title varchar(255) [null]
  seo_description varchar(500) [null]
  og_media_id "bigint unsigned" [null]
  canonical_url varchar(2048) [null]
  robots varchar(80) [not null, default: 'index,follow']
  draft_data json [null, note: 'Một bản chỉnh sửa trang chờ đăng, không có lịch sử phiên bản.']
  status content_status [not null, default: 'DRAFT']
  scheduled_at datetime [null]
  published_at datetime [null]
  created_by "bigint unsigned" [not null]
  updated_by "bigint unsigned" [not null]
  deleted_at datetime [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (blog_id, slug) [unique]
    (blog_id, page_key) [unique]
    (blog_id, id) [unique]
  }
}

Table posts {
  Note: 'Một hàng cho mỗi bài: nội dung Tiptap JSON, ảnh cover và SEO. draft_data giữ tối đa một bản chỉnh sửa chờ đăng; không có lịch sử phiên bản bài viết.'
  id "bigint unsigned" [pk, increment, not null]
  blog_id "bigint unsigned" [not null]
  title varchar(160) [not null]
  slug varchar(160) [not null]
  author_user_id "bigint unsigned" [not null]
  excerpt text [null]
  content_json json [not null]
  cover_media_id "bigint unsigned" [null]
  seo_title varchar(255) [null]
  seo_description varchar(500) [null]
  og_media_id "bigint unsigned" [null]
  canonical_url varchar(2048) [null]
  robots varchar(80) [not null, default: 'index,follow']
  draft_data json [null, note: 'Một bản chỉnh sửa chờ xuất bản của bài đang public; không phải lịch sử phiên bản. Validate cùng schema nội dung và SEO.']
  status content_status [not null, default: 'DRAFT']
  scheduled_at datetime [null]
  published_at datetime [null]
  is_featured boolean [not null, default: false]
  updated_by "bigint unsigned" [not null]
  deleted_at datetime [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (blog_id, slug) [unique]
    (blog_id, id) [unique]
    (blog_id, status, published_at)
    (status, scheduled_at)
  }
}

Table categories {
  Note: 'Danh mục bài viết trong từng blog; không dùng lại blog_topics.'
  id "bigint unsigned" [pk, increment, not null]
  blog_id "bigint unsigned" [not null]
  name varchar(160) [not null]
  slug varchar(160) [not null]
  description text [null]
  parent_id "bigint unsigned" [null]
  is_active boolean [not null, default: true]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (blog_id, slug) [unique]
    (blog_id, id) [unique]
  }
}

Table tags {
  Note: 'Tag riêng trong mỗi blog.'
  id "bigint unsigned" [pk, increment, not null]
  blog_id "bigint unsigned" [not null]
  name varchar(160) [not null]
  slug varchar(160) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (blog_id, slug) [unique]
    (blog_id, id) [unique]
  }
}

Table post_categories {
  Note: 'N:M với composite FK bảo vệ phạm vi blog.'
  id "bigint unsigned" [pk, increment, not null]
  blog_id "bigint unsigned" [not null]
  post_id "bigint unsigned" [not null]
  category_id "bigint unsigned" [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (post_id, category_id) [unique]
  }
}

Table post_tags {
  Note: 'N:M với composite FK bảo vệ phạm vi blog.'
  id "bigint unsigned" [pk, increment, not null]
  blog_id "bigint unsigned" [not null]
  post_id "bigint unsigned" [not null]
  tag_id "bigint unsigned" [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (post_id, tag_id) [unique]
  }
}

Table media_assets {
  Note: 'Một thư viện Cloudinary dùng chung. JSON nội dung lưu media_id và URL; không có bảng liên kết media riêng. Backend kiểm tra quyền và tất cả tham chiếu JSON trước khi xóa ảnh.'
  id "bigint unsigned" [pk, increment, not null]
  scope media_scope [not null]
  blog_id "bigint unsigned" [null]
  uploaded_by "bigint unsigned" [not null]
  cloud_name varchar(120) [not null]
  cloudinary_asset_id varchar(128) [null]
  cloudinary_public_id varchar(255) [null]
  cloudinary_version "bigint unsigned" [null]
  resource_type varchar(20) [not null, default: 'image']
  delivery_type varchar(40) [not null, default: 'upload']
  secure_url varchar(2048) [null]
  original_name varchar(255) [not null]
  format varchar(40) [null]
  mime_type varchar(120) [null]
  width "int unsigned" [null]
  height "int unsigned" [null]
  bytes "bigint unsigned" [null]
  alt_text varchar(500) [null]
  status media_status [not null, default: 'UPLOADING']
  deleted_at datetime [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (cloud_name, cloudinary_asset_id) [unique]
    (blog_id, status, created_at)
  }
}

Table content_reports {
  Note: 'Báo cáo blog hoặc bài viết. Không có báo cáo bình luận. Platform Admin xử lý theo quyền; thay đổi ghi vào admin_audit_logs.'
  id "bigint unsigned" [pk, increment, not null]
  blog_id "bigint unsigned" [not null]
  target_type report_target [not null]
  post_id "bigint unsigned" [null]
  reporter_user_id "bigint unsigned" [null]
  reason text [not null]
  status report_status [not null, default: 'OPEN']
  assigned_to "bigint unsigned" [null]
  resolved_by "bigint unsigned" [null]
  resolution_note text [null]
  resolved_at datetime [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (status, created_at)
  }
}

Table admin_audit_logs {
  Note: 'Thao tác nền tảng và blog. resource_type/resource_id là snapshot log, không phải quan hệ đa hình bảo đảm FK.'
  id "bigint unsigned" [pk, increment, not null]
  actor_user_id "bigint unsigned" [not null]
  blog_id "bigint unsigned" [null]
  action varchar(120) [not null]
  resource_type varchar(80) [not null]
  resource_id varchar(80) [null]
  before_data json [null]
  after_data json [null]
  ip_address varchar(45) [null]
  request_id varchar(64) [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (actor_user_id, created_at)
    (blog_id, created_at)
  }
}

Table platform_settings {
  Note: 'Một bản ghi id=1. config_json chứa branding/SEO/discovery/limits/features/security; backend chỉ trả các khóa public được cho phép. Secrets ở env.'
  id "tinyint unsigned" [pk, not null, default: 1]
  config_json json [not null]
  updated_by "bigint unsigned" [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
  }
}

Table notifications {
  Note: 'Thông báo cho user; delivery email do queue thực hiện. recipient_user_id là FK trực tiếp nên cần custom notification channel/mapping nếu dùng Laravel DatabaseNotification mặc định.'
  id char(36) [pk, not null]
  recipient_user_id "bigint unsigned" [not null]
  type varchar(160) [not null]
  data json [not null]
  read_at datetime [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (recipient_user_id, read_at, created_at)
  }
}

Table blog_designs {
  Note: '1:1 với blog. published_data/draft_data lưu toàn bộ layout, theme, sections, menu và snapshot template; publish đổi JSON trong một transaction, không tạo hàng revision.'
  blog_id "bigint unsigned" [pk, not null]
  template_id "bigint unsigned" [null]
  draft_template_id "bigint unsigned" [null]
  published_data json [null]
  draft_data json [null]
  published_at datetime [null]
  updated_by "bigint unsigned" [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
  }
}

Ref: platform_role_permissions.role_id > platform_roles.id [delete: restrict, update: restrict]
Ref: user_platform_roles.role_id > platform_roles.id [delete: restrict, update: restrict]
Ref: platform_role_permissions.permission_id > permissions.id [delete: restrict, update: restrict]
Ref: user_platform_roles.user_id > users.id [delete: restrict, update: restrict]
Ref: user_platform_roles.granted_by > users.id [delete: restrict, update: restrict]
Ref: sessions.user_id > users.id [delete: cascade, update: restrict]
Ref: account_restrictions.user_id > users.id [delete: restrict, update: restrict]
Ref: account_restrictions.issued_by > users.id [delete: restrict, update: restrict]
Ref: account_restrictions.revoked_by > users.id [delete: restrict, update: restrict]
Ref: security_audit_logs.actor_user_id > users.id [delete: restrict, update: restrict]
Ref: security_audit_logs.subject_user_id > users.id [delete: restrict, update: restrict]
Ref: blog_topics.created_by > users.id [delete: restrict, update: restrict]
Ref: blogs.owner_user_id > users.id [delete: restrict, update: restrict]
Ref: blog_topic_assignments.blog_id > blogs.id [delete: restrict, update: restrict]

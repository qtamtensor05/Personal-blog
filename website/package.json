{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint app/Presentation/Js vite.config.js",
        "lint:fix": "eslint app/Presentation/Js vite.config.js --fix",
        "format": "prettier --write app/Presentation/Js app/Presentation/Css vite.config.js package.json ../README.md && npm run format:php",
        "format:check": "prettier --check app/Presentation/Js app/Presentation/Css vite.config.js package.json ../README.md && npm run format:php:check",
        "format:php": "prettier --write app config database routes tests",
        "format:php:check": "prettier --check app config database routes tests",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@prettier/plugin-php": "^0.25.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.6",
        "prettier-plugin-blade": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@aejkatappaja/phantom-ui": "^1.6.1",
        "@tiptap/core": "3.32.0",
        "@tiptap/extension-image": "3.32.0",
        "@tiptap/pm": "3.32.0",
        "@tiptap/starter-kit": "3.32.0"
    }
}
